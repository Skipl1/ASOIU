# Скопируйте в .env и заполните значения. Файл .env не добавляется в git.

# --- База данных ---
POSTGRES_USER=grsn
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=grsn
# Пароль ограниченной учётной записи приложения grsn_app (если не задан, выводится из POSTGRES_PASSWORD)
# APP_DB_PASSWORD=

# --- Безопасность (ТЗ 4.3) ---
# Секрет подписи JWT: длинная случайная строка, например: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-random-48-chars
ACCESS_TOKEN_MINUTES=30
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# --- Модель генерации: GigaChat ---
# gigachat — внешний API GigaChat; mock — только локальный генератор (без внешних обращений)
LLM_PROVIDER=gigachat
# Ключ авторизации (Authorization key) из личного кабинета developers.sber.ru → проект GigaChat API
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# GigaChat-2-Pro — основная модель; GigaChat-2 — облегчённая модель Lite (быстрее, но слабее)
GIGACHAT_MODEL=GigaChat-2-Pro
GIGACHAT_VERIFY_SSL_CERTS=true
# Freemium допускает один поток; при платном пакете можно увеличить
LLM_MAX_CONCURRENCY=1
LLM_TIMEOUT_SECONDS=25
LLM_QUEUE_WAIT_SECONDS=30
# При ошибке или недоступности GigaChat использовать локальный генератор
LLM_FALLBACK_TO_MOCK=true
# Фоновый прогрев соединения и токена GigaChat, секунды (0 — отключить)
GIGACHAT_KEEPALIVE_SECONDS=30

# --- Начальное наполнение ---
ADMIN_EMAIL=admin@grsn.local
ADMIN_PASSWORD=Admin12345
ADMIN_NAME=Администратор
# Демо-пользователь demo@grsn.local / Demo12345 с историей рецептов за неделю
SEED_DEMO=true

# --- Веб-сервер ---
# false — сайт по HTTP без сертификата (http://localhost:8080);
# true — HTTPS с самоподписанным сертификатом (https://localhost:8443), требование ТЗ 7.3
ENABLE_HTTPS=false

# --- Ресурсы контейнеров (ТЗ: сервер от 2 ядер и 4 ГБ ОЗУ) ---
# По умолчанию в сумме ровно 2 ядра и 4 ГБ. Посмотреть: scripts/show_limits.ps1 или bash scripts/show_limits.sh
# DB_CPUS=0.75
# DB_MEMORY=1536m
# BACKEND_CPUS=1.0
# BACKEND_MEMORY=1792m
# FRONTEND_CPUS=0.15
# FRONTEND_MEMORY=256m
# BACKUP_CPUS=0.1
# BACKUP_MEMORY=512m

# --- Прочее ---
APP_TIMEZONE=Europe/Moscow
API_WORKERS=2
BACKUP_RETENTION_DAYS=30
BACKUP_CRON=0 3 * * *
# Папка резервных копий на ОТДЕЛЬНОМ диске (ТЗ 4.3: копия хранится отдельно от базы данных).
# Windows: BACKUP_PATH=D:/grsn_backups   Linux-сервер: BACKUP_PATH=/mnt/backup
# Не задано — копии хранятся в томе Docker (на том же диске, что и база).
# BACKUP_PATH=D:/grsn_backups
HTTP_PORT=8080
HTTPS_PORT=8443
# Порт PostgreSQL на этом компьютере (127.0.0.1) для просмотра БД в DBeaver / pgAdmin / SQLTools
DB_PORT=5432
SERVER_NAME=localhost
