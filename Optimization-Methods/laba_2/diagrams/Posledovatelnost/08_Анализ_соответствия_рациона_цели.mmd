%%{init: {"sequence": {"actorMargin": 18, "messageMargin": 22, "boxMargin": 6}}}%%
sequenceDiagram
    autonumber
    actor U as Пользователь
    participant Web as Web-интерфейс
    participant API as REST API
    participant Analysis as AnalysisService
    participant DB as PostgreSQL

    U->>Web: Открыть раздел анализа
    Web-->>U: Показать период и кнопку обновления
    U->>Web: Выбрать период и нажать Обновить анализ
    Web->>API: GET /analysis/nutrition
    API->>Analysis: Получить анализ соответствия цели
    Analysis->>DB: Прочитать профиль, цель и целевую калорийность
    DB-->>Analysis: Целевые значения
    Analysis->>DB: Прочитать рецепты рациона за период
    DB-->>Analysis: Фактические ккал и БЖУ по дням
    Analysis->>DB: Прочитать замеры веса, оценки и запреты
    DB-->>Analysis: parameter_history, оценки, ограничения
    Analysis->>Analysis: Сравнить цель и факт, рассчитать отклонения и индекс соответствия
    Analysis->>Analysis: Расчётный тренд веса по калорийности и фактический тренд по замерам
    Analysis->>Analysis: Прогноз веса на 30 дней
    Analysis->>Analysis: Сформировать рекомендации по приоритетам
    Analysis-->>API: NutritionAnalysis
    API-->>Web: 200 OK
    Web-->>U: Показать сравнение, график веса, индекс и рекомендации
