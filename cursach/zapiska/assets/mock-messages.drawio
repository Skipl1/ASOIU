<mxfile host="app.diagrams.net"><diagram name="mock-messages" id="mock-messages"><mxGraphModel dx="820" dy="365" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="820" pageHeight="365" background="#ffffff"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="2" value="АС ГРСН   /   Состояния и сообщения" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=7;fontFamily=Arial;fontSize=23;fontColor=#111827;strokeColor=#64748b;fillColor=#e8eefc;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="10" y="10" width="800" height="48" as="geometry" /></mxCell><mxCell id="3" value="Профиль  |  Запреты  |  Продукты  |  Рецепты  |  История  |  Отчёты" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=7;fontFamily=Arial;fontSize=17;fontColor=#111827;strokeColor=#64748b;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="10" y="65" width="800" height="36" as="geometry" /></mxCell><mxCell id="4" value="Ошибка поля: «Укажите массу от 30 до 300 кг» — исправить выделенное поле." style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=7;fontFamily=Arial;fontSize=17;fontColor=#111827;strokeColor=#64748b;fillColor=#f8fafc;" vertex="1" parent="1"><mxGeometry x="30" y="112" width="760" height="52" as="geometry" /></mxCell><mxCell id="5" value="Нельзя выполнить: «Недостаточно допустимых продуктов» — изменить набор, сохранить запреты." style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=7;fontFamily=Arial;fontSize=17;fontColor=#111827;strokeColor=#64748b;fillColor=#f8fafc;" vertex="1" parent="1"><mxGeometry x="30" y="172" width="760" height="52" as="geometry" /></mxCell><mxCell id="6" value="Информация: «Использован локальный генератор» — показать источник в карточке." style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacingLeft=10;spacingRight